# ==========================================================
# FASE 1 — Telegram Bot
# ==========================================================

# Token do bot, obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ID do Telegram do administrador (número, não username)
# Para descobrir: fale com @userinfobot no Telegram
ADMIN_TELEGRAM_ID=

# ID do grupo de sinais que o bot deve monitorar (número negativo, ex: -1001234567890)
# Preenchido/validado na Fase 4. Pode ficar vazio por enquanto.
SIGNAL_GROUP_ID=

# Ambiente de execução
NODE_ENV=development

# ==========================================================
# FASE 3+ — Banco de dados (Postgres/Supabase) — OBRIGATÓRIO
# ==========================================================
DATABASE_URL=postgres://user:password@localhost:5432/trading_bot

# ==========================================================
# FASE 3+ — Segurança / Criptografia — OBRIGATÓRIO
# ==========================================================

# Chave de 32 bytes em hex (64 caracteres) usada para criptografar API keys/secrets no banco.
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=

# Hash (scrypt) da senha usada para confirmar fechamento manual de operações (/fechar, Fase 8).
# OBRIGATÓRIO a partir da Fase 8. NUNCA colocar a senha em texto puro aqui.
# Gerar com: npm run hash:password -- "SuaSenhaAqui"
# Formato esperado: scrypt:<salt em hex>:<hash em hex>
CLOSE_OPERATION_PASSWORD_HASH=

# ==========================================================
# FASE 6 — Modo de operação
# ==========================================================

# "test"  -> interpreta, mostra o que seria executado, calcula quantidade
#            com saldo real (leitura), mas NUNCA envia ordem real.
# "live"  -> envia ordens reais para as exchanges (abre posição, SL, TP).
#            Só ative depois de validar tudo em "test". Use conta com saldo
#            pequeno e API key sem permissão de saque.
TRADING_MODE=test

# ==========================================================
# FASE 2+ — Exchanges (as credenciais REAIS de cada conta ficam
# no banco, criptografadas — isto aqui é só para testes locais
# de conectividade com a API, se necessário)
# ==========================================================
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_API_PASSPHRASE=
